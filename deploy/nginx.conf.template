# Single-container deploy: nginx serves the built React app and
# proxies everything the frontend actually calls to gunicorn, which
# listens on 127.0.0.1:8000 inside the same container.
#
# $PORT is substituted by deploy/start.sh at container start (envsubst),
# defaulting to 80 — this is what lets the same image run on platforms
# that inject their own PORT (Render, Railway, ...) as well as a plain
# `docker run -p 8080:80`.

server {
    listen ${PORT};
    server_name _;
    client_max_body_size 20m;

    # React build output
    root /usr/share/nginx/html;
    index index.html;

    # Everything the frontend's axios clients and the Telegram webhook
    # call goes to Django (see help-desk_backend-main/urls.py).
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /app/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /webhook/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Ticket attachments (served by Django itself, see urls.py's static() call)
    location /media/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }

    # Django admin's own CSS/JS, collected at build time. Scoped to
    # these two subpaths specifically (the only ones collectstatic
    # produces) because the React build's own JS/CSS also lives under
    # /static/ (CRA's default) — a blanket /static/ alias here would
    # shadow it and 404 the whole app.
    location /static/admin/ {
        alias /static/admin/;
    }

    location /static/rest_framework/ {
        alias /static/rest_framework/;
    }

    # React Router: anything else falls back to index.html
    # (this also serves the CRA build's own /static/js, /static/css, ...
    # as plain files via the `root` above, since try_files checks $uri first)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
